#!/bin/bash
# omasnap wrapper for XerahS (XERAHS_OMASNAP_PATH in its systemd unit points here).
# XerahS opens the annotation editor with --file only, so OmaSnap puts it on Qt's primary
# screen. Pass --handoff-monitor = the monitor where the selection was made (written by the
# slurp wrapper), or the one under the cursor.
real=/usr/lib/xerahs/omasnap/omasnap
LAST_MONITOR=${XDG_RUNTIME_DIR:-/tmp}/xerahs-last-monitor

file=0
for a in "$@"; do
  case $a in
    --file) file=1 ;;
    --handoff-monitor*) exec "$real" "$@" ;;
  esac
done
((file)) || exec "$real" "$@"

# Alt+S with the slurp wrapper: the editor only opens when the selection was taken with E.
# After a plain click, answer like OmaSnap would with the image unchanged, so XerahS saves
# and copies it right away.
EDIT_FLAG=${XDG_RUNTIME_DIR:-/tmp}/xerahs-edit
if [[ -f $EDIT_FLAG ]] && (($(date +%s) - $(stat -c %Y "$EDIT_FLAG") < 120)); then
  edit=$(<"$EDIT_FLAG")
  rm -f "$EDIT_FLAG"
  if [[ $edit == 0 ]]; then
    in= out= res=
    args=("$@")
    for ((i = 0; i < ${#args[@]}; i++)); do
      case ${args[i]} in
        --file) in=${args[i + 1]} ;;
        --output) out=${args[i + 1]} ;;
        --result-json) res=${args[i + 1]} ;;
      esac
    done
    if [[ -f $in && -n $out && -n $res ]] && cp -- "$in" "$out"; then
      # PNG IHDR: width and height, big endian, at byte 16
      read -r w h < <(od -An -tu1 -j16 -N8 -- "$in" |
        awk '{ print $1 * 16777216 + $2 * 65536 + $3 * 256 + $4, $5 * 16777216 + $6 * 65536 + $7 * 256 + $8 }')
      printf '{"schemaVersion":1,"status":"ok","target":"file","path":"%s","pixelWidth":%d,"pixelHeight":%d,"logicalWidth":%d,"logicalHeight":%d,"scale":1,"monitor":"","region":null,"window":null,"annotated":false,"action":"both","documentPath":null,"omasnapVersion":"xerahs-snap"}\n' \
        "$out" "${w:-0}" "${h:-0}" "${w:-0}" "${h:-0}" >"$res"
      exit 0
    fi
  fi
fi

mon=
if [[ -f $LAST_MONITOR ]] && (($(date +%s) - $(stat -c %Y "$LAST_MONITOR") < 120)); then
  mon=$(<"$LAST_MONITOR")
fi
if [[ -z $mon && -n $HYPRLAND_INSTANCE_SIGNATURE ]] && command -v jq >/dev/null; then
  read -r cx cy < <(hyprctl -j cursorpos 2>/dev/null | jq -r '"\(.x | floor) \(.y | floor)"')
  [[ -n $cx ]] && mon=$(hyprctl -j monitors 2>/dev/null | jq -r --argjson px "$cx" --argjson py "$cy" '
    [.[] | select($px >= .x and $py >= .y
                  and $px < .x + ((if .transform % 2 == 1 then .height else .width end) / .scale)
                  and $py < .y + ((if .transform % 2 == 1 then .width else .height end) / .scale))
    ][0].name // empty')
fi

[[ -n $mon ]] && exec "$real" "$@" --handoff-monitor "$mon"
exec "$real" "$@"
