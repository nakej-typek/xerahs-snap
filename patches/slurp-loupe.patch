+#define LOUPE_GAP 24
+#define LOUPE_TAU 6.283185307179586
+
+// ShareX-style round magnifier next to the cursor (x, y in layout coordinates). The -Z image
+// is a screenshot of the whole layout, whose top-left corner is the smallest output origin.
+static void draw_loupe(cairo_t *cairo, struct slurp_state *state,
+		struct slurp_output *output, int32_t x, int32_t y) {
+	int32_t ox = INT32_MAX, oy = INT32_MAX;
+	struct slurp_output *o;
+	wl_list_for_each(o, &state->outputs, link) {
+		if (o->logical_geometry.x < ox) {
+			ox = o->logical_geometry.x;
+		}
+		if (o->logical_geometry.y < oy) {
+			oy = o->logical_geometry.y;
+		}
+	}
+	const int zoom = state->loupe_zoom, pixels = state->loupe_pixels; // pixels is odd
+	const int half = pixels / 2, size = pixels * zoom, label = 22;
+	const double r = size / 2.0;
+	struct slurp_box *g = &output->logical_geometry;
+	double cx = x - g->x, cy = y - g->y;
+	double lx = cx + LOUPE_GAP, ly = cy + LOUPE_GAP;
+	if (lx + size > g->width) {
+		lx = cx - LOUPE_GAP - size;
+	}
+	if (ly + size + label > g->height) {
+		ly = cy - LOUPE_GAP - size - label;
+	}
+
+	cairo_save(cairo);
+	cairo_new_path(cairo);
+	cairo_arc(cairo, lx + r, ly + r, r, 0, LOUPE_TAU);
+	cairo_clip(cairo);
+	cairo_set_operator(cairo, CAIRO_OPERATOR_SOURCE);
+	set_source_u32(cairo, 0x000000FF); // outside the image (screen edge)
+	cairo_paint(cairo);
+	cairo_save(cairo);
+	cairo_translate(cairo, lx, ly);
+	cairo_scale(cairo, zoom, zoom);
+	cairo_set_source_surface(cairo, state->loupe,
+		-(x - ox - half), -(y - oy - half));
+	cairo_pattern_set_filter(cairo_get_source(cairo), CAIRO_FILTER_NEAREST);
+	cairo_paint(cairo);
+	cairo_restore(cairo);
+
+	// Crosshair through the centre pixel, which itself gets a black/white outline.
+	cairo_set_operator(cairo, CAIRO_OPERATOR_OVER);
+	double c0 = half * zoom;
+	set_source_u32(cairo, (state->colors.border & 0xFFFFFF00) | 0x60);
+	cairo_rectangle(cairo, lx, ly + c0, c0, zoom);
+	cairo_rectangle(cairo, lx + c0 + zoom, ly + c0, c0, zoom);
+	cairo_rectangle(cairo, lx + c0, ly, zoom, c0);
+	cairo_rectangle(cairo, lx + c0, ly + c0 + zoom, zoom, c0);
+	cairo_fill(cairo);
+	cairo_set_line_width(cairo, 1);
+	set_source_u32(cairo, 0x000000FF);
+	cairo_rectangle(cairo, lx + c0 - 0.5, ly + c0 - 0.5, zoom + 1, zoom + 1);
+	cairo_stroke(cairo);
+	set_source_u32(cairo, 0xFFFFFFFF);
+	cairo_rectangle(cairo, lx + c0 + 0.5, ly + c0 + 0.5, zoom - 1, zoom - 1);
+	cairo_stroke(cairo);
+	cairo_restore(cairo);
+
+	cairo_save(cairo);
+	cairo_set_operator(cairo, CAIRO_OPERATOR_OVER);
+	// Ring
+	cairo_new_path(cairo);
+	cairo_arc(cairo, lx + r, ly + r, r + 1, 0, LOUPE_TAU);
+	cairo_set_line_width(cairo, 2);
+	set_source_u32(cairo, state->colors.border);
+	cairo_stroke(cairo);
+	// Position (and zoom) centred below the loupe
+	char text[48];
+	snprintf(text, sizeof(text), "X: %d  Y: %d  %dx", x, y, zoom);
+	cairo_select_font_face(cairo, state->font_family,
+		CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_NORMAL);
+	cairo_set_font_size(cairo, 12);
+	cairo_text_extents_t ext;
+	cairo_text_extents(cairo, text, &ext);
+	double tw = ext.x_advance + 12, tx = lx + r - tw / 2;
+	set_source_u32(cairo, 0x000000C0);
+	cairo_rectangle(cairo, tx, ly + size + 4, tw, label - 4);
+	cairo_fill(cairo);
+	set_source_u32(cairo, 0xFFFFFFFF);
+	cairo_move_to(cairo, tx + 6, ly + size + label - 6);
+	cairo_show_text(cairo, text);
+	cairo_restore(cairo);
+}
