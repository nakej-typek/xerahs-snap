+static int ppm_int(FILE *f) {
+	int c, v = 0;
+	while ((c = fgetc(f)) != EOF) {
+		if (c == '#') {
+			while ((c = fgetc(f)) != EOF && c != '\n') {
+			}
+			continue;
+		}
+		if (c >= '0' && c <= '9') {
+			break;
+		}
+	}
+	if (c == EOF) {
+		return -1;
+	}
+	do {
+		v = v * 10 + (c - '0');
+	} while ((c = fgetc(f)) >= '0' && c <= '9');
+	return v;
+}
+
+// Binary PPM (P6, 8 bit) as written by `grim -t ppm`, for the -Z magnifier.
+static cairo_surface_t *load_ppm(const char *path) {
+	FILE *f = fopen(path, "rb");
+	if (f == NULL) {
+		return NULL;
+	}
+	cairo_surface_t *surface = NULL;
+	int width, height;
+	if (fgetc(f) != 'P' || fgetc(f) != '6' || (width = ppm_int(f)) <= 0 ||
+			(height = ppm_int(f)) <= 0 || ppm_int(f) != 255) {
+		goto out;
+	}
+	surface = cairo_image_surface_create(CAIRO_FORMAT_RGB24, width, height);
+	unsigned char *data = cairo_image_surface_get_data(surface);
+	int stride = cairo_image_surface_get_stride(surface);
+	unsigned char rgb[3];
+	for (int y = 0; y < height; y++) {
+		uint32_t *row = (uint32_t *)(data + (size_t)y * stride);
+		for (int x = 0; x < width; x++) {
+			if (fread(rgb, 1, 3, f) != 3) {
+				cairo_surface_destroy(surface);
+				surface = NULL;
+				goto out;
+			}
+			row[x] = (uint32_t)rgb[0] << 16 | (uint32_t)rgb[1] << 8 | rgb[2];
+		}
+	}
+	cairo_surface_mark_dirty(surface);
+out:
+	fclose(f);
+	return surface;
+}
