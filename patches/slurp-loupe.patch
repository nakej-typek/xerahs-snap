+// Scroll up zooms the magnifier in, scroll down out (one step per wheel notch).
+static void pointer_handle_axis(void *data, struct wl_pointer *wl_pointer,
+		uint32_t time, uint32_t axis, wl_fixed_t value) {
+	struct slurp_seat *seat = data;
+	struct slurp_state *state = seat->state;
+	if (!state->loupe || axis != WL_POINTER_AXIS_VERTICAL_SCROLL) {
+		return;
+	}
+	state->loupe_scroll += wl_fixed_to_double(value);
+	int steps = (int)(state->loupe_scroll / 10);
+	if (steps == 0) {
+		return;
+	}
+	state->loupe_scroll -= steps * 10;
+	int i = 0;
+	while (i < LOUPE_LEVELS - 1 && loupe_levels[i].zoom < state->loupe_zoom) {
+		i++;
+	}
+	i -= steps;
+	i = i < 0 ? 0 : i >= LOUPE_LEVELS ? LOUPE_LEVELS - 1 : i;
+	state->loupe_zoom = loupe_levels[i].zoom;
+	state->loupe_pixels = loupe_levels[i].pixels;
+	seat_set_outputs_dirty(seat);
