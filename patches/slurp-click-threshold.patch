diff --git a/include/slurp.h b/include/slurp.h
index bcfac26..65c04ca 100644
--- a/include/slurp.h
+++ b/include/slurp.h
@@ -11,6 +11,8 @@
 #include "xdg-output-unstable-v1-client-protocol.h"
 
 #define TOUCH_ID_EMPTY -1
+// Pointer travel (px) before a press becomes a drag; less is still a click on the box under it.
+#define DRAG_THRESHOLD 5
 
 struct slurp_box {
 	int32_t x, y;
@@ -25,6 +27,7 @@ struct slurp_selection {
 	int32_t anchor_x, anchor_y;
 	struct slurp_box selection;
 	bool has_selection;
+	bool dragging; // moved past DRAG_THRESHOLD since the button went down
 };
 
 struct slurp_state {
diff --git a/main.c b/main.c
index 22238e4..4f1caa1 100644
--- a/main.c
+++ b/main.c
@@ -112,6 +112,14 @@ static void handle_active_selection_motion(struct slurp_seat *seat, struct slurp
 	int32_t dist_x = current_selection->x - anchor_x;
 	int32_t dist_y = current_selection->y - anchor_y;
 
+	// A click that wobbles by a pixel or two must keep the box under the cursor instead of
+	// turning into a tiny drag selection.
+	if (!current_selection->dragging && abs(dist_x) < DRAG_THRESHOLD &&
+			abs(dist_y) < DRAG_THRESHOLD) {
+		return;
+	}
+	current_selection->dragging = true;
+
 	current_selection->has_selection = true;
 	// selection includes the seat and anchor positions
 	int32_t width = abs(dist_x) + 1;
@@ -223,6 +231,7 @@ static void handle_selection_start(struct slurp_seat *seat,
 	} else {
 		current_selection->anchor_x = current_selection->x;
 		current_selection->anchor_y = current_selection->y;
+		current_selection->dragging = false;
 	}
 }
 
